# MindfulNest Tooling — Environment Variables (Example)
# Copy to .env and fill in real values. .env is gitignored.
# Per LD-327 APP_REPO_SESSION_DIRECTUS_CRED_LOADING_V1, autonomous sessions
# working from this tree must explicitly handle credential loading — env
# vars are the canonical mechanism here (Doppler is the production path
# per LD-208 RENT_DOPPLER_SECRETS).

# === Directus (audit trail, locked decisions, activity log) ===
DIRECTUS_URL=https://directus-production-3460.up.railway.app
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
# Aliases also accepted by directus_admin_client.py:
# DIRECTUS_EMAIL=
# DIRECTUS_PASSWORD=

# === Animation / Video Generation ===
WAVESPEED_API_KEY=
BFL_API_KEY=

# === TTS ===
ELEVENLABS_API_KEY=

# === LLM / Image Generation ===
OPENAI_API_KEY=

# === Optional vendors (per LD-208 ENV var roster) ===
# RUNWAY_API_KEY=
# FAL_KEY=
# REPLICATE_API_TOKEN=
# SEGMIND_API_KEY=
# EVOLINK_API_KEY=
# GEMINI_API_KEY=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_USER=
# RAILWAY_PROJECT=
# RAILWAY_API_TOKEN=

# === Server runtime flags ===
# Skip cross-machine Directus lock when running solo on one machine:
# PRODUCTION_SERVER_SINGLE_MACHINE=1

# === Local-dev shortcut (Mac only) ===
# When working on a Mac with Dropbox synced, production_server.py + lib/directus_admin_client.py
# fall back to reading API_KEYS_MASTER.md from the Dropbox path automatically:
#   ~/Library/CloudStorage/Dropbox/Claude Mindfulnest Project Files/Production/API_KEYS_MASTER.md
# In CI (no Dropbox), env vars above are required.
