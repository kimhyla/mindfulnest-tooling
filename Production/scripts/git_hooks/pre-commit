#!/usr/bin/env bash
# Pre-commit: block divergent Dropbox runtime tree edits.
# Per V59 CI/CD gap-fix Phase G / LD PRE_COMMIT_DROPBOX_EDIT_GATE_V1.
#
# This file is the SOURCE for the local-only .git/hooks/pre-commit. Install
# via Production/scripts/install_pre_commit_hook.sh. The hook itself is not
# version-controlled at .git/hooks/ (per spec §3 — solo-dev scope, no Husky).
#
# Override mechanism: MN_SKIP_DROPBOX_EDIT_GATE=1 git commit ...
#
# Two checks (both fail-closed):
#   1) Any STAGED file whose Dropbox runtime mtime is newer than the
#      tooling-repo file → FATAL ("you edited Dropbox runtime then forgot
#      to deploy first; commit would lose those edits").
#   2) Any tooling-tracked file whose Dropbox runtime mtime is newer than
#      .last_deploy → WARN/FATAL ("you've been editing Dropbox runtime
#      since the last deploy; commit may not reflect what's running").
#
# Both checks fail-OPEN (silently exit 0) when:
#   - Dropbox tree doesn't exist on this machine (e.g. work PC)
#   - Tooling-repo path doesn't exist
#   - .last_deploy sentinel never written
# That's intentional per §0.8 — better to skip on a machine where the gate
# doesn't apply than to block legitimate commits.

set -euo pipefail

DROPBOX_ROOT="${MN_DROPBOX_ROOT:-$HOME/Library/CloudStorage/Dropbox/Claude Mindfulnest Project Files}"
TOOLING_ROOT="$(git rev-parse --show-toplevel)"

# Override
if [[ "${MN_SKIP_DROPBOX_EDIT_GATE:-}" = "1" ]]; then
    echo "PRE-COMMIT: MN_SKIP_DROPBOX_EDIT_GATE=1 — gate bypassed."
    exit 0
fi

# Fail-OPEN if Dropbox tree not present (e.g. work PC, fresh clone)
if [[ ! -d "$DROPBOX_ROOT" ]]; then
    echo "PRE-COMMIT: Dropbox tree not found at $DROPBOX_ROOT — gate skipped (fail-open)."
    exit 0
fi

stat_mtime() {
    # macOS BSD stat first, fall back to GNU stat (Linux), then date as last resort.
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || date -r "$1" +%s 2>/dev/null
}

FATAL=0
WARN_FATAL_THRESHOLD=1   # Set to 0 to demote check 2 from FATAL to WARN.

# ---- Check 1: staged files with newer Dropbox mtime ------------------------
while IFS= read -r staged; do
    [[ -z "$staged" ]] && continue
    repo_path="$TOOLING_ROOT/$staged"
    dropbox_path="$DROPBOX_ROOT/$staged"
    [[ -f "$repo_path" ]] || continue
    [[ -f "$dropbox_path" ]] || continue
    repo_mtime=$(stat_mtime "$repo_path")
    dropbox_mtime=$(stat_mtime "$dropbox_path")
    if [[ -z "$repo_mtime" || -z "$dropbox_mtime" ]]; then
        continue
    fi
    if [[ "$dropbox_mtime" -gt "$repo_mtime" ]]; then
        echo "FATAL: $staged has newer mtime in Dropbox runtime tree."
        echo "  Run Production/scripts/deploy_storyboard_v59.sh first,"
        echo "  or set MN_SKIP_DROPBOX_EDIT_GATE=1 to bypass."
        FATAL=1
    fi
done < <(git diff --cached --name-only)

# ---- Check 2: any tracked file edited in Dropbox after .last_deploy --------
LAST_DEPLOY_FILE="$TOOLING_ROOT/.last_deploy"
if [[ -f "$LAST_DEPLOY_FILE" ]]; then
    last_deploy=$(cat "$LAST_DEPLOY_FILE" 2>/dev/null || echo 0)
    if [[ "$last_deploy" =~ ^[0-9]+$ ]] && [[ "$last_deploy" -gt 0 ]]; then
        # Bounded scan: 200 tracked files max to keep stat-call cost reasonable.
        # If perf becomes an issue, switch to `find -newer .last_deploy`.
        while IFS= read -r tracked; do
            [[ -z "$tracked" ]] && continue
            dropbox_path="$DROPBOX_ROOT/$tracked"
            [[ -f "$dropbox_path" ]] || continue
            dropbox_mtime=$(stat_mtime "$dropbox_path")
            if [[ -z "$dropbox_mtime" ]]; then
                continue
            fi
            if [[ "$dropbox_mtime" -gt "$last_deploy" ]]; then
                echo "WARN: $tracked edited in Dropbox after last deploy ($(date -r "$last_deploy" 2>/dev/null || echo "?"))."
                echo "  Commit may not reflect what's running."
                if [[ "$WARN_FATAL_THRESHOLD" -eq 1 ]]; then
                    FATAL=1
                fi
            fi
        done < <(git ls-files | head -200)
    fi
fi

if [[ "$FATAL" -eq 1 ]]; then
    echo ""
    echo "Pre-commit blocked. See above. Override: MN_SKIP_DROPBOX_EDIT_GATE=1 git commit ..."
    exit 1
fi
echo "Pre-commit Dropbox-edit gate: clean."

# ============================================================================
# Watch list anti-pattern detection (LD 560 WATCH_LIST_MECHANICAL_ENFORCEMENT_V1)
# Master tech spec v6 §9 — these patterns must NEVER reach a commit
# ============================================================================

WATCHLIST_FAIL=0

# Pattern 1: Live overlay with cue timing (LD-280 violation)
# setTimeout/setInterval near video timeUpdate handlers in client OR ffmpeg overlay filters in server
if git diff --cached -- '*.tsx' '*.ts' '*.js' 2>/dev/null | grep -E '^\+.*timeUpdate.*setTimeout|^\+.*setInterval.*videoRef|^\+.*ffmpeg.*-filter_complex.*overlay' > /dev/null 2>&1; then
    echo "FATAL §9.1: Live overlay with cue timing detected (master spec v6 §9 hard line)."
    echo "  See: Production/docs/MINDFULNEST_TECH_SPEC_v6.md §9 + LD-280 RENDERING_ARCHITECTURE_SINGLE_MP4_ATOMIC_V1"
    WATCHLIST_FAIL=1
fi

# Pattern 2: Runtime TTS (ElevenLabs SDK in app/ or MindfulNest/)
if git diff --cached -- 'app/*' 'MindfulNest/*' 2>/dev/null | grep -E "^\+.*from ['\"]elevenlabs|^\+.*import.*elevenlabs|^\+.*ELEVENLABS_API_KEY" > /dev/null 2>&1; then
    echo "FATAL §9.2: Runtime TTS detected in app/ or MindfulNest/ (master spec v6 §9 hard line)."
    echo "  Production pipeline imports OK; app-side runtime TTS is forbidden per LD-281 NO_RUNTIME_TTS_PERSONALIZATION_V1"
    WATCHLIST_FAIL=1
fi

# Pattern 3: expo-audio in app/module/ playback path
if git diff --cached -- 'app/module/*' 'MindfulNest/app/module/*' 2>/dev/null | grep -E "^\+.*from ['\"]expo-audio|^\+.*import.*expo-audio" > /dev/null 2>&1; then
    echo "FATAL §9.3: expo-audio in app/module/ playback path (LD-280 violation)."
    echo "  One MP4 atomic playback only; no expo-audio + expo-video composition."
    WATCHLIST_FAIL=1
fi

# Pattern 4: Per-child audio variables in production output paths
if git diff --cached -- '*.mp3' '*.mp4' '*.json' '*.txt' 2>/dev/null | grep -E "^\+.*\\{(childName|therapistName|parentName|chosenGuideName|parentTitle)\\}" > /dev/null 2>&1; then
    echo "FATAL §9.4: Per-child audio variables in production output (LD-281 violation)."
    echo "  Variables must resolve at production-pipeline authoring time, not in shipped artifacts."
    WATCHLIST_FAIL=1
fi

# Pattern 5: Multi-file expo-video playlist patterns
if git diff --cached -- 'app/*' 'MindfulNest/*' 2>/dev/null | grep -E '^\+.*<Video.*source=.*\}.*\n.*<Video' > /dev/null 2>&1; then
    echo "FATAL §9.5: Multi-file expo-video playlist pattern detected (LD-280 violation)."
    echo "  Single MP4 atomic playback per module."
    WATCHLIST_FAIL=1
fi

if [ "$WATCHLIST_FAIL" -eq 1 ]; then
    echo ""
    echo "Watch list violations detected — see master spec v6 §9 hard lines."
    echo "Override (only with Kim explicit approval): MN_SKIP_WATCHLIST_GATE=1 + register"
    echo "  SHORTCUT_WATCHLIST_BYPASS_<reason>_V1 LD before retrying."
    if [ "${MN_SKIP_WATCHLIST_GATE:-}" = "1" ]; then
        echo "MN_SKIP_WATCHLIST_GATE=1 set — bypass requires SHORTCUT LD."
        # Future: query Directus for SHORTCUT_WATCHLIST_BYPASS_*_V1 to enforce
        echo "WARNING: bypass active but audit row not verified — Kim must register SHORTCUT manually."
    else
        exit 1
    fi
fi
echo "Pre-commit watch list gate: clean."

# ============================================================================
# Smoke manifest co-location gate (LD-782 EVENT_SMOKE_TEST_LAYER1_V1 §5)
# When a commit modifies storyboard UI source AND mentions a new LD-XXX in
# the commit message, require that Production/smoke_test_manifest.yaml is
# also staged. Catches the fabrication-class commit where an agent claims
# to ship a UI feature without appending the verification manifest entry.
# Bypass: MN_SKIP_MANIFEST_GATE=1 (refactor/bugfix commits with no new feature).
# ============================================================================

MANIFEST_FAIL=0
COMMIT_MSG_FILE="$TOOLING_ROOT/.git/COMMIT_EDITMSG"

if [[ -f "$COMMIT_MSG_FILE" ]] && [[ -s "$COMMIT_MSG_FILE" ]]; then
    commit_msg=$(cat "$COMMIT_MSG_FILE")
    if echo "$commit_msg" | grep -qE 'LD-[0-9]{3,4}'; then
        ui_files=$(git diff --cached --name-only | grep -E '^Production/tools/storyboard-v2/src/.*\.tsx?$' || true)
        manifest_staged=$(git diff --cached --name-only | grep -E '^Production/smoke_test_manifest\.yaml$' || true)
        if [[ -n "$ui_files" ]] && [[ -z "$manifest_staged" ]]; then
            echo "WARN: commit modifies storyboard UI AND mentions LD-XXX but"
            echo "  Production/smoke_test_manifest.yaml is NOT staged."
            echo "  Per LD-782 §5, every UI-shipping LD must append a manifest entry"
            echo "  in the same commit. Modified UI files:"
            echo "$ui_files" | sed 's/^/    /'
            echo ""
            echo "  If this commit ships a NEW user-visible feature:"
            echo "    1) add an entry to Production/smoke_test_manifest.yaml"
            echo "    2) git add Production/smoke_test_manifest.yaml"
            echo "    3) retry git commit"
            echo "  If refactor/bugfix only (no new feature surface): bypass with"
            echo "    MN_SKIP_MANIFEST_GATE=1 git commit ..."
            if [[ "${MN_SKIP_MANIFEST_GATE:-}" != "1" ]]; then
                MANIFEST_FAIL=1
            else
                echo "  MN_SKIP_MANIFEST_GATE=1 — bypass accepted."
            fi
        fi
    fi
fi

if [[ "$MANIFEST_FAIL" -eq 1 ]]; then
    echo ""
    echo "Pre-commit blocked by manifest co-location gate (LD-782 §5)."
    exit 1
fi
echo "Pre-commit manifest co-location gate: clean."
