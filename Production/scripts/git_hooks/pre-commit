#!/usr/bin/env bash
# Pre-commit: block divergent Dropbox runtime tree edits.
# Per V59 CI/CD gap-fix Phase G / LD PRE_COMMIT_DROPBOX_EDIT_GATE_V1.
#
# This file is the SOURCE for the local-only .git/hooks/pre-commit. Install
# via Production/scripts/install_pre_commit_hook.sh. The hook itself is not
# version-controlled at .git/hooks/ (per spec §3 — solo-dev scope, no Husky).
#
# Override mechanism: MN_SKIP_DROPBOX_EDIT_GATE=1 git commit ...
#
# Two checks (both fail-closed):
#   1) Any STAGED file whose Dropbox runtime mtime is newer than the
#      tooling-repo file → FATAL ("you edited Dropbox runtime then forgot
#      to deploy first; commit would lose those edits").
#   2) Any tooling-tracked file whose Dropbox runtime mtime is newer than
#      .last_deploy → WARN/FATAL ("you've been editing Dropbox runtime
#      since the last deploy; commit may not reflect what's running").
#
# Both checks fail-OPEN (silently exit 0) when:
#   - Dropbox tree doesn't exist on this machine (e.g. work PC)
#   - Tooling-repo path doesn't exist
#   - .last_deploy sentinel never written
# That's intentional per §0.8 — better to skip on a machine where the gate
# doesn't apply than to block legitimate commits.

set -euo pipefail

DROPBOX_ROOT="${MN_DROPBOX_ROOT:-$HOME/Library/CloudStorage/Dropbox/Claude Mindfulnest Project Files}"
TOOLING_ROOT="$(git rev-parse --show-toplevel)"

# Override
if [[ "${MN_SKIP_DROPBOX_EDIT_GATE:-}" = "1" ]]; then
    echo "PRE-COMMIT: MN_SKIP_DROPBOX_EDIT_GATE=1 — gate bypassed."
    exit 0
fi

# Fail-OPEN if Dropbox tree not present (e.g. work PC, fresh clone)
if [[ ! -d "$DROPBOX_ROOT" ]]; then
    echo "PRE-COMMIT: Dropbox tree not found at $DROPBOX_ROOT — gate skipped (fail-open)."
    exit 0
fi

stat_mtime() {
    # macOS BSD stat first, fall back to GNU stat (Linux), then date as last resort.
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || date -r "$1" +%s 2>/dev/null
}

FATAL=0
WARN_FATAL_THRESHOLD=1   # Set to 0 to demote check 2 from FATAL to WARN.

# ---- Check 1: staged files with newer Dropbox mtime ------------------------
while IFS= read -r staged; do
    [[ -z "$staged" ]] && continue
    repo_path="$TOOLING_ROOT/$staged"
    dropbox_path="$DROPBOX_ROOT/$staged"
    [[ -f "$repo_path" ]] || continue
    [[ -f "$dropbox_path" ]] || continue
    repo_mtime=$(stat_mtime "$repo_path")
    dropbox_mtime=$(stat_mtime "$dropbox_path")
    if [[ -z "$repo_mtime" || -z "$dropbox_mtime" ]]; then
        continue
    fi
    if [[ "$dropbox_mtime" -gt "$repo_mtime" ]]; then
        echo "FATAL: $staged has newer mtime in Dropbox runtime tree."
        echo "  Run Production/scripts/deploy_storyboard_v59.sh first,"
        echo "  or set MN_SKIP_DROPBOX_EDIT_GATE=1 to bypass."
        FATAL=1
    fi
done < <(git diff --cached --name-only)

# ---- Check 2: any tracked file edited in Dropbox after .last_deploy --------
LAST_DEPLOY_FILE="$TOOLING_ROOT/.last_deploy"
if [[ -f "$LAST_DEPLOY_FILE" ]]; then
    last_deploy=$(cat "$LAST_DEPLOY_FILE" 2>/dev/null || echo 0)
    if [[ "$last_deploy" =~ ^[0-9]+$ ]] && [[ "$last_deploy" -gt 0 ]]; then
        # Bounded scan: 200 tracked files max to keep stat-call cost reasonable.
        # If perf becomes an issue, switch to `find -newer .last_deploy`.
        while IFS= read -r tracked; do
            [[ -z "$tracked" ]] && continue
            dropbox_path="$DROPBOX_ROOT/$tracked"
            [[ -f "$dropbox_path" ]] || continue
            dropbox_mtime=$(stat_mtime "$dropbox_path")
            if [[ -z "$dropbox_mtime" ]]; then
                continue
            fi
            if [[ "$dropbox_mtime" -gt "$last_deploy" ]]; then
                echo "WARN: $tracked edited in Dropbox after last deploy ($(date -r "$last_deploy" 2>/dev/null || echo "?"))."
                echo "  Commit may not reflect what's running."
                if [[ "$WARN_FATAL_THRESHOLD" -eq 1 ]]; then
                    FATAL=1
                fi
            fi
        done < <(git ls-files | head -200)
    fi
fi

if [[ "$FATAL" -eq 1 ]]; then
    echo ""
    echo "Pre-commit blocked. See above. Override: MN_SKIP_DROPBOX_EDIT_GATE=1 git commit ..."
    exit 1
fi
echo "Pre-commit Dropbox-edit gate: clean."
