# MindfulNest Directus MCP server — environment variables (example only).
#
# DO NOT CHECK IN A FILLED VERSION OF THIS FILE.
#
# Preferred: store these in Doppler (per LD-208 RENT_SECRETS_VIA_DOPPLER).
# Doppler-injected env vars are picked up by the server automatically when
# it's launched via `doppler run -- python server.py`.
#
# Fallback: if Doppler is unavailable, set these in your shell rc OR rely on
# Production/API_KEYS_MASTER.md being readable from a known path
# (per LD-227 SHORTCUT_CREDSTORE_MD_FALLBACK_20260418).

# Directus connection (REQUIRED)
DIRECTUS_URL=https://directus-production-3460.up.railway.app
DIRECTUS_ADMIN_EMAIL=...
DIRECTUS_ADMIN_PASSWORD=...

# Validator config (OPTIONAL)
# Mode: strict (default — raise on unknown keys) | warn | skip
# Override per-collection in ~/.claude/state/payload_validator_overrides.json
PAYLOAD_VALIDATOR_MODE=strict

# Browser-smoke gate (Phase F mechanical gate per DS-21)
# Set to 1 ONLY when MCP-side _COMPLETE writes need to bypass the gate
# (this server has no UI, so smoke is trivially N/A for MCP-internal phases).
# When set, you MUST write a BROWSER_SMOKE_DEFERRED row first explaining why.
# MN_SKIP_BROWSER_SMOKE_GATE=1
