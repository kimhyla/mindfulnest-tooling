# MindfulNest Tooling Repo — .gitignore
# This repo holds production tooling source ONLY (Python servers + storyboard-v2 client).
# All media stays out. All secrets stay out. All caches/backups stay out.

# Node / Vite / Playwright
node_modules/
dist/
dist-ssr/
test-results/
playwright-report/
.vite/
.parcel-cache/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Rhubarb Lip Sync — built locally via Production/scripts/setup_rhubarb_arm64.sh
Production/tools/bin/rhubarb
Production/tools/bin/res/

# Backup files (production_server.py.bak.* etc.)
*.bak
*.bak.*
*.bak_*
*.pre_*
*.tmp.*

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Secrets
.env
.env.local
.env.*.local
.doppler/
API_KEYS_MASTER.md

# Media — never ship
*.mp4
*.mov
*.m4v
*.webm
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.tiff
*.bmp
*.pdf
*.psd
*.ai

# MindfulNest production media folders — explicit excludes (belt + suspenders)
Production/Event_*/
Production/Magic/
Production/Milestones/
Production/Sessions/
Production/_previews/
Production/Voice_Profiles/
Production/tts_cache/
Production/Cache/
Production/Character_Assets/
Production/Arc_*/
Production/Modules/
Production/Final_Mixes/
Production/audio/
Production/video/

# E2E test fixture (proper-fix Phase 1 §17) — explicitly tracked despite Event_*/ + media globs
!Production/Event_e2e_fixture/
!Production/Event_e2e_fixture/**
# Mutation-prone files inside the fixture stay ignored (Q10B counter finding) — globalSetup copies pristine over them
Production/Event_e2e_fixture/production_state.json
Production/Event_e2e_fixture/production_spend.json
Production/Event_e2e_fixture/.backups/
Production/Event_e2e_fixture/clips_dir/
# Generated dist must stay out
Production/Event_e2e_fixture/dist/
# Pristine snapshots are the canonical seed — explicitly tracked
!Production/Event_e2e_fixture/.pristine/
!Production/Event_e2e_fixture/.pristine/**
# Override the global `production_state.json` rule (line 94) for the pristine copy
!Production/Event_e2e_fixture/.pristine/production_state.json

# Pending writes (Directus offline queue)
pending_directus_writes*.json
pending_directus_writes*.jsonl
.pending_directus_writes*

# State files (per-machine; should not be committed)
production_state.json

# Durable recovery audit log (BEAT_GRAFT_RECOVERY_MECHANISM_V1, C-7).
# JSONL append-only; per-machine forensic record of /api/beat/graft
# operations. Directus prod_activity_log is the cross-machine mirror.
Production/.recovery_audit.jsonl

# Archive subdirs
archive/
**/archive/

# E2E fixture pristine snapshot — final negation overrides global production_state.json rule above
!Production/Event_e2e_fixture/.pristine/production_state.json

# ============ Runtime state (audit Item 1, severity CRITICAL — 2026-05-07) ============
# Per SILENT_DEFERRALS_AUDIT_20260507.md Item 1 + Kim authorization 2026-05-07.
# Runtime byproducts (server PIDs, fixture locks, runtime JSON state) that previously
# left the working tree dirty and tripped session-start STOP checks. Patterns added
# AFTER all pristine-snapshot negations so existing fixture rules are preserved.
*.pid
.state.lock
*.L.json
beat_generator_state.json

# ============ Builder-script outputs with baked-in credentials (CodeQL #96/#97) ============
# Per Phase 3.5e 2026-05-18.
# build_image_selector_cropper.py and build_tts_review.py substitute Directus
# credentials into the generated HTML at build time so the in-browser tool
# can authenticate against Directus directly. The output is intended for
# LOCAL dev only — accidentally committing it leaks the user's Directus
# password. CodeQL flagged this as py/clear-text-storage-sensitive-data.
# Defense: gitignore the canonical output filenames so `git add` refuses
# them. The build script itself is repo-tracked + safe (template only).
image_selector_cropper.html
image_selector_cropper_*.html
tts_review.html
tts_review_*.html
